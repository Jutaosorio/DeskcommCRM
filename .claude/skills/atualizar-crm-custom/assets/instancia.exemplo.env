# Modelo de .astra/local/instancia.env — copie e preencha. O destino é ignorado pelo git.
# Este arquivo é público (vive no fork): só placeholders, nunca dado real.

# ── Repositórios ───────────────────────────────────────────────────────────────
# UPSTREAM_SLUG=melgarafael/DeskcommCRM     # padrão
# FORK_BASE=main                            # branch do fork que recebe a atualização

# ── VPS ────────────────────────────────────────────────────────────────────────
VPS_SSH=meu-alias-ssh                        # vazio ou "local" = você já está na VPS
VPS_PROJETO=/caminho/do/projeto              # pasta com o .env e os compose
# VPS_PREFIXO=meuprojeto                     # contêineres <prefixo>-app-1; padrão: COMPOSE_PROJECT_NAME do .env
# VPS_SERVICOS="app worker scheduler"        # padrão
# VPS_MIGRACAO=/caminho/das/fotos            # padrão: <projeto>/.atualizacoes (modo 700)
# VPS_BACKUP_CMD="bash hostgator-setup-kit/backup.sh"   # padrão
# VPS_BACKUP_LOG=/caminho/do/backup.log      # padrão: <VPS_MIGRACAO>/backup.log
# VPS_DOMINIO=crm.exemplo.com                # padrão: DOMAIN do .env da VPS
